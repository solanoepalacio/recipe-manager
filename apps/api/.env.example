# --- Database ---
DATABASE_URL=postgresql://recipe_manager:recipe_manager@localhost:5432/recipe_manager

# --- Postgres container (read by the `db` service in docker-compose.yml) ---
# These MUST match the user / password / database encoded in DATABASE_URL above.
POSTGRES_USER=recipe_manager
POSTGRES_PASSWORD=recipe_manager
POSTGRES_DB=recipe_manager

# --- Session secrets — use long random strings in production ---
SESSION_SECRET=change-me-in-production
ADMIN_SESSION_SECRET=change-me-admin-in-production

# --- Base URL used in generated reset URLs (no trailing slash) ---
APP_URL=http://localhost:3000

# --- Dev seed: agent (bot) API token for test automation ---
# Optional. The dev seed (seed:dev) creates a bot member with a deterministic
# API key so automations can authenticate as the agent via:
#   Authorization: Bearer <token>
# Leave unset to use the built-in default, or set a fixed value your automation
# already knows. Only consumed by seed:dev — not used at runtime.
DEV_AGENT_API_TOKEN=

# --- Analytics (Umami) ---
# Self-hosted Umami instance URL (e.g. http://192.168.1.50:3000)
UMAMI_URL=
# Website ID from Umami Dashboard -> Settings -> Websites
UMAMI_WEBSITE_ID=
# Hostname shown in Umami dashboard (e.g. localhost, recipe-manager.example.com)
APP_HOSTNAME=localhost
